# Docker Compose project name
COMPOSE_PROJECT_NAME=grid-repair

# Port mappings
FRONTEND_PORT=20104
BACKEND_PORT=21104
DB_PORT=33060

# Database credentials (used by the db service and backend)
DB_NAME=app_db
DB_USER=app_user
DB_PASSWORD=app_password

# Backend JWT secret (change in production)
JWT_SECRET=local-dev-secret

# Backend data directory for the file-backed persistent store
DATA_DIR=/app/data

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
