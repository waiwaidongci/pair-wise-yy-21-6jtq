# Compose 项目名（容器名前缀）
COMPOSE_PROJECT_NAME=grid-repair

# 前端端口（宿主机）
FRONTEND_PORT=20104

# 后端端口（宿主机；容器内部固定 3000）
BACKEND_PORT=21104

# MySQL 端口（宿主机）
DB_PORT=33060

# 数据库凭据
DB_NAME=app_db
DB_USER=app_user
DB_PASSWORD=app_password

# JWT 密钥（生产环境务必修改）
JWT_SECRET=local-dev-secret

# 复电确认事务重试
RESTORE_TX_MAX_RETRIES=5
RESTORE_LOCK_WAIT_MS=5000

# 数据源驱动：mysql（默认，Docker 部署）/ memory（本地无数据库演示与测试）
DB_DRIVER=mysql
